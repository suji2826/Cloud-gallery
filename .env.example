# ==========================================
# CloudGallery - Environment Configuration
# ==========================================

# 1. AWS Region
AWS_REGION="us-east-1"
VITE_AWS_REGION="us-east-1"

# 2. Firebase Authentication (Client-side Web App)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# 3. Amazon API Gateway HTTP API Endpoint
# When deployed to AWS, this will be your API Gateway URL (e.g., https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod)
# When running locally, set to /api or your custom proxy
VITE_API_GATEWAY_URL="/api"

# 4. Amazon CloudFront CDN Distribution
# Serves edge-cached thumbnails with Origin Access Control (OAC)
VITE_CLOUDFRONT_URL="https://d111111abcdef8.cloudfront.net"
CLOUDFRONT_DOMAIN="d111111abcdef8.cloudfront.net"

# 5. Amazon S3 Storage Buckets (Serverless Backend)
ORIGINALS_BUCKET="cloudgallery-originals-prod"
THUMBNAILS_BUCKET="cloudgallery-thumbnails-prod"

# 6. Amazon DynamoDB Metadata Table
PHOTOS_TABLE="CloudGalleryPhotos"

# 7. AI Studio Platform Injection (Optional)
GEMINI_API_KEY=""
APP_URL=""
