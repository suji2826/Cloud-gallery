# ==============================================================================
# AWS SAM CLI Configuration Example (samconfig.toml.example)
# Copy this file to samconfig.toml or let `sam deploy --guided` create it
# ==============================================================================

version = 0.1

[default]
[default.global.parameters]
stack_name = "cloudgallery-stack-prod"

[default.build.parameters]
cached = true
parallel = true
use_container = true

[default.validate.parameters]
lint = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM CAPABILITY_AUTO_EXPAND"
confirm_changeset = false
fail_on_empty_changeset = false
stack_name = "cloudgallery-stack-prod"
s3_prefix = "cloudgallery-stack-prod"
region = "us-east-1"
parameter_overrides = "Environment=\"prod\" CorsAllowedOrigin=\"*\""
image_repositories = []

[default.package.parameters]
resolve_s3 = true

[default.sync.parameters]
watch = true

[default.local_start_api.parameters]
warm_containers = "EAGER"

[default.local_start_lambda.parameters]
warm_containers = "EAGER"
